<?xml version="1.0" encoding="utf-8"?>
<!--
  debug 变体专用 Manifest（仅参与 debug 构建，release 不受影响）。

  为什么需要它：
  build.gradle 里 debug 的 API_BASE_URL 是 http://39.106.113.189:8082，
  而 targetSdk 34 起 Android 默认禁止明文 HTTP（usesCleartextTraffic=false）。
  不声明的话 debug 包一上来就会抛
  "Cleartext HTTP traffic to 39.106.113.189 not permitted"，
  导致设备注册、埋点上报、广告配置拉取全部失败 —— 测试环境等于不可用。

  为什么只在 debug：
  release 的 API_BASE_URL 是 https://api.batteryhd.pro，本就不需要明文；
  把 cleartext 放行写进 main 会让正式包也允许明文流量，属于实质性安全退让。
  sourceSet 隔离能保证这个口子只开在开发包上。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
