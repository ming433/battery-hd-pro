# 复制为 billing.properties 后填写。该文件已被 gitignore，不要提交真实值。
#
# 这里只放 Play Console 的商品 ID，不是密钥。
# 服务账号 JSON、Pub/Sub 订阅名、OIDC audience 放在服务端环境变量：
#   PLAY_PACKAGE_NAME
#   PLAY_PUBSUB_SUBSCRIPTION
#   PLAY_OIDC_AUDIENCE
# 见 backend/config/play.php。不要把这些 secret 放进 App。

# 订阅商品 ID，必须与 Play Console productId 大小写一致。
PLAY_PRODUCT_ID=pro_monthly

# 订阅基础方案 ID（base plan）。留空则使用该商品的第一个优惠。
PLAY_BASE_PLAN_ID=monthly

# 可选优惠 ID（offer）。留空表示不指定优惠。
PLAY_OFFER_ID=
