APP_NAME="Battery HD Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.batteryhd.pro
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------- 数据库（与 deploy/.env 保持一致）
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=battery_hd_pro
DB_USERNAME=batteryhd
DB_PASSWORD=ChangeMe_User_2026

# ---------------------------------------------------------- 缓存 / 会话 / 队列
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ---------------------------------------------------------- 埋点
ANALYTICS_DEDUPE_DRIVER=redis   # redis | database

# ---------------------------------------------------------- 安全
COOKIE_SECURE=true
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=*
