# ============================================================
#  Battery HD Pro — 部署环境变量示例
#  复制为 deploy/.env 后修改密码，再执行 ./deploy.sh
# ============================================================

# ---------------------------------------------------------- 端口
# 若与 devutils 部署在同一台机器，需避开其占用的 80/443/8080/8081
HTTP_PORT=8082
HTTPS_PORT=8443
ORIGIN_PORT=8085

# ---------------------------------------------------------- MySQL
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026
MYSQL_DATABASE=battery_hd_pro
MYSQL_USER=batteryhd
MYSQL_PASSWORD=ChangeMe_User_2026

# ---------------------------------------------------------- 部署目标（供 deploy.sh 使用）
DEPLOY_HOST=39.106.113.189
DEPLOY_USER=root
DEPLOY_SSH_KEY=~/.ssh/id_rsa
DEPLOY_DIR=/work/batteryhd
